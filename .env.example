NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
USER_BOT_USERNAME=VeyraAppBot
USER_BOT_TOKEN=
ADMIN_BOT_USERNAME=VeyraAdminBot
ADMIN_BOT_TOKEN=
OFFICIAL_CHANNEL_USERNAME=VeyraDating
OWNER_TELEGRAM_ID=
DATABASE_URL=
# A URL only; --tls redis-cli input is also normalized automatically.
REDIS_URL=rediss://default:CHANGE_ME@HOST:6379
GEOAPIFY_API_KEY=
SUPABASE_URL=
# Supabase sb_secret_... key or legacy service_role JWT; not the database password.
SUPABASE_SECRET_KEY=
# Set false ONLY for a local PostgreSQL container. Hosted DB uses verified TLS.
DB_SSL=true
AUTO_SETUP_BOTS=false
